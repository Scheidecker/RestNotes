# Author: Carlos Scheidecker
# Local development only; Compose supplies documented demo defaults.
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
# Uncomment and set credential entries only to override the local demo defaults.
DB_USERNAME=APIUser
# DB_PASSWORD=
# MYSQL_ROOT_PASSWORD=
DEMO_DATA_ENABLED=true
# Registration defaults on in dev/test and off in UAT/prod.
# REGISTRATION_ENABLED=false
JWT_TTL_SECONDS=900
JWT_ISSUER=RestNotes
JWT_AUDIENCE=RestNotes-api
# Both locations must be file: URIs visible inside the JVM/container.
# Configure read-only secret mounts separately; never put keys into this file or image.
# JWT_PRIVATE_KEY_LOCATION=file:/run/secrets/restnotes-private.pem
# JWT_PUBLIC_KEY_LOCATION=file:/run/secrets/restnotes-public.pem
