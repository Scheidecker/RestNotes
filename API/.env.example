# API host port. No credentials are needed to run the Phase 1 API.
SERVER_PORT=8081
SPRING_PROFILES_ACTIVE=dev
LOG_LEVEL=INFO
# Optional database scaffold only; supply local passwords securely before enabling it.
# Database integration, demo defaults, migrations and seed records arrive in Phase 2.
DB_USERNAME=APIUser
DB_PASSWORD=
MYSQL_ROOT_PASSWORD=
